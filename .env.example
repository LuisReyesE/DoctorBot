# Ambiente: development | production
APP_ENV=development

DATABASE_URL=sqlite:///./doctorbot.db

# mock | telegram | meta
MESSAGING_PROVIDER=mock

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Secreto opcional (texto corto). NUNCA pongas aquí la URL de ngrok.
TELEGRAM_WEBHOOK_SECRET=
# URL del túnel sin path (ej. https://xxxx.ngrok-free.app). Vacío = auto desde ngrok :4040
TELEGRAM_WEBHOOK_URL=
TELEGRAM_AUTO_WEBHOOK=true

# --- Meta / WhatsApp ---
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=Doctor Bot_verify
META_APP_SECRET=

SEED_DOCTOR_ID=51999900001
SEED_DOCTOR_NAME=Dr. Demo

PANEL_ENABLED=true
PANEL_TOKEN=admin

REQUIRE_SUBSCRIPTION=true
TRIAL_DAYS=3
PRICE_MONTHLY=8.0
PRICE_QUARTERLY=22.0
# Destino del cobro (un Yape del proyecto). Las cajas se agregan en /panel/cajas
YAPE_PHONE=
YAPE_NAME=
PLIN_PHONE=
PLIN_NAME=
# Opcional: foto del QR en storage/pay/yape-qr.png
PAYMENT_QR_PATH=
REMINDER_HOURS=48
REMINDER_AUTO=true
REMINDER_POLL_SECONDS=900
JITSI_BASE_URL=https://meet.jit.si
